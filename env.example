# Copy to .env and set values. Used by docker-compose.prod.yml on the server.
# Do NOT commit .env. Set these in Hostinger Container Environment UI or in .env on the VPS.

# Required for backend
JWT_SECRET=

# MongoDB (used to build MONGO_URI for backend; must match MONGO_INITDB_* in mongodb service)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=mrd_audit

# Optional overrides (backend gets MONGO_URI from compose using the vars above)
# CORS_ORIGIN is set in docker-compose.prod.yml to https://checklist.mapims.edu.in
